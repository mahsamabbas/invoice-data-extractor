# Backend (copy to backend/.env for local runs; compose sets these inline)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl
OLLAMA_TIMEOUT_SECONDS=120
CORS_ORIGINS=http://localhost:3006
MAX_UPLOAD_BYTES=5242880
# Optional: override the bundled sample invoice path
# SAMPLE_INVOICE_PATH=/samples/sample_invoice.png

# Frontend (copy to frontend/.env.local; baked in at build time for Docker)
VITE_API_BASE=http://localhost:8006
